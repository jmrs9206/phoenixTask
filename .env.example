# PhoenixTask® environment template
# Copy to .env and adjust per environment.

# Ports
PHOENIXTASK_PG_PORT=5433
PHOENIXTASK_BACKEND_PORT=8080
PHOENIXTASK_FRONTEND_PORT=3000

# Postgres (local/dev)
POSTGRES_USER=phoenixtask
POSTGRES_PASSWORD=phoenixtask_local
POSTGRES_DB=postgres

# Controlplane database (tenant registry)
PHOENIXTASK_DB_HOST=localhost
PHOENIXTASK_DB_PORT=5433
PHOENIXTASK_CONTROL_DB=phoenixtask_local
PHOENIXTASK_DB_USER=phoenixtask
PHOENIXTASK_DB_PASSWORD=phoenixtask_local

# Workspace database (demo tenant)
PHOENIXTASK_WS_DB_HOST=localhost
PHOENIXTASK_WS_DB_PORT=5433
PHOENIXTASK_WS_DB_NAME=phoenixtask_demo
PHOENIXTASK_WS_DB_SCHEMA=public
PHOENIXTASK_WS_DB_USER=phoenixtask
PHOENIXTASK_WS_DB_PASSWORD=phoenixtask_local

# Attachments
PHOENIXTASK_ATTACHMENTS_ROOT=./storage/attachments
PHOENIXTASK_ATTACHMENTS_MAX_BYTES=10485760

# Controlplane admin bootstrap (set in dev/staging/prod)
PHOENIXTASK_CONTROLPLANE_ADMIN_BOOTSTRAP_KEY=
PHOENIXTASK_CONTROLPLANE_ADMIN_BOOTSTRAP_LABEL=bootstrap

# Secret hardening (recommended for non-local)
# Base64-encoded 32-byte values (invalid encryption key fails startup)
PHOENIXTASK_SECURITY_KEY_PEPPER=
PHOENIXTASK_SECURITY_ENCRYPTION_KEY=

# Git integration validation (optional)
PHOENIXTASK_INTEGRATIONS_GIT_VALIDATE_ON_CREATE=false

# Demo credentials (local)
PHOENIXTASK_DEMO_EMAIL=sofia.ramos@phoenixtask.demo
PHOENIXTASK_DEMO_PASSWORD=PhoenixTask2026!
PHOENIXTASK_DEMO_TENANT=demo

# Frontend public config
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080
NEXT_PUBLIC_TENANT_CODE=demo
